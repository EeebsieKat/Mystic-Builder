+/* Full-screen starfield for the CSS menu backdrop. */
+.mk-stars {
+  background-image:
+    radial-gradient(1px 1px at 12% 22%, rgba(255, 255, 255, 0.5) 50%, transparent 51%),
+    radial-gradient(1px 1px at 28% 64%, rgba(255, 255, 255, 0.35) 50%, transparent 51%),
+    radial-gradient(1.5px 1.5px at 44% 12%, rgba(255, 244, 214, 0.55) 50%, transparent 51%),
+    radial-gradient(1px 1px at 61% 48%, rgba(255, 255, 255, 0.3) 50%, transparent 51%),
+    radial-gradient(1px 1px at 74% 18%, rgba(255, 255, 255, 0.45) 50%, transparent 51%),
+    radial-gradient(1.5px 1.5px at 86% 58%, rgba(255, 244, 214, 0.4) 50%, transparent 51%),
+    radial-gradient(1px 1px at 92% 32%, rgba(255, 255, 255, 0.35) 50%, transparent 51%),
+    radial-gradient(1px 1px at 18% 82%, rgba(255, 255, 255, 0.28) 50%, transparent 51%),
+    radial-gradient(1px 1px at 52% 88%, rgba(255, 255, 255, 0.24) 50%, transparent 51%),
+    radial-gradient(1.5px 1.5px at 68% 78%, rgba(255, 244, 214, 0.3) 50%, transparent 51%);
+  animation: mk-twinkle 7s ease-in-out infinite alternate;
+}
+
+@keyframes mk-twinkle {
+  from {
+    opacity: 0.55;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .mk-stars {
+    animation: none;
+  }
+}
+
+/* Version banner (was the header tab-bar label). */
+.mk-version-label {
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.22em;
+  color: var(--lo-gold, #e0a33e);
