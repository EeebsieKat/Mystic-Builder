+}
+.mk-site-info-compact a {
+  color: rgba(224, 163, 62, 0.7);
+  text-decoration: none;
+  transition: color 150ms ease;
+}
+.mk-site-info-compact a:hover {
+  color: #f0c470;
+}
+
+/* ---- menu buttons --------------------------------------------------- */
+
+.mk-button {
+  display: flex;
