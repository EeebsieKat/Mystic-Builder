From 323dfd76737775e690d554f675210cbde049daf8 Mon Sep 17 00:00:00 2001
From: Mystic Builder Dev <dev@mysticbuilder.local>
Date: Thu, 19 Nov 2026 19:51:40 +0000
Subject: [PATCH] Fix build import: add missing v8 -> v9 upgrade step

Importing build links (e.g. from reforged.dauntless-builder.com) failed
with 'Could not decode that build' ever since CURRENT_BUILD_ID was
bumped to 9: the upgrade chain in upgrade-build.ts still ended at
v7 -> v8, so an incoming v8 build (25 numbers) was re-serialized by the
normalize pass as a 28-number build that kept its version 8 stamp. That
hybrid matched neither the v8 (25 numbers) nor the v9 (28 numbers)
branch of BuildModel.isValid, so tryDeserialize returned null.

- Add convertVersion8To9: decode with the v8 sqids alphabet, stamp
  version 9, append the three new consumable slots as empty (0/0/0) -
  the v9 layout only appends fields, all v8 positions are unchanged
- Wire the version 8 branch into the upgradeBuild chain
- Re-stamp build.version to CURRENT_BUILD_ID in the normalize pass so
  serialize can never emit an old-version/new-length hybrid again

Verified: the reported link now imports (weapon, bond, cells, omnicell
all resolve), v2/v4/v5/v6/v7 legacy ids upgrade cleanly, fresh v9
round-trips are untouched, garbage ids still rejected.
---
 src/game/upgrade-build.ts | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/game/upgrade-build.ts b/src/game/upgrade-build.ts
index a883bde..7796473 100755
--- a/src/game/upgrade-build.ts
+++ b/src/game/upgrade-build.ts
@@ -1,5 +1,5 @@
 /**
- * Upgrade chain for old build versions (v2 -> v8).
+ * Upgrade chain for old build versions (v2 -> v9).
  *
  * Ported from dauntless-builder-reforged (https://github.com/atomicptr/dauntless-builder-reforged)
  * which is licensed under AGPL-3.0. This file is therefore also AGPL-3.0.
@@ -180,6 +180,17 @@ export const convertVersion7To8 = (version7BuildId: string): UpgradeResult => {
     return { buildId: buildIdsEncode(numbers), wasUpgraded: false };
 };
 
+export const convertVersion8To9 = (version8BuildId: string): UpgradeResult => {
+    const numbers = buildIdsDecode(version8BuildId, BuildIdsProvider.SQIDS_V8);
+
+    // v9 only appended the three consumable slots after the omnicell,
+    // so every v8 field keeps its position. Fill the new slots as empty.
+    numbers[0] = 9;
+    numbers.push(0, 0, 0);
+
+    return { buildId: buildIdsEncode(numbers), wasUpgraded: false };
+};
+
 export const upgradeBuild = (buildId: string): string => {
     const buildVersion = () => {
         try {
@@ -229,9 +240,18 @@ export const upgradeBuild = (buildId: string): string => {
         buildId = newBuildId;
     }
 
+    if (buildVersion() === 8) {
+        const { buildId: newBuildId } = convertVersion8To9(buildId);
+        buildId = newBuildId;
+    }
+
     try {
         const build = BuildModel.deserialize(buildId);
 
+        // Always re-stamp to the current format so serialize() cannot emit a
+        // hybrid (old version number with new field count) that fails isValid.
+        build.version = CURRENT_BUILD_ID;
+
         if (buildWasUpgraded) {
             build.addFlag(BuildFlags.UpgradedBuild);
         }
-- 
